<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Analytics.AnalyticsController"
            prefWidth="1400"
            prefHeight="850"
            style="-fx-background-color:#eef3fb;">

    <!-- ================= HEADER ================= -->

    <top>

        <HBox alignment="CENTER"
              prefHeight="90"
              style="-fx-background-color:#1f5fe0;">

            <children>

                <Label text="📊 Property Analytics Dashboard"
                       textFill="WHITE"
                       style="-fx-font-weight:bold;">

                    <font>
                        <Font size="34"/>
                    </font>

                </Label>

            </children>

        </HBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <GridPane alignment="CENTER"
                  hgap="35"
                  vgap="35">

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="30"
                        left="30"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- ================= Customer Types ================= -->

            <VBox GridPane.columnIndex="0"
                  GridPane.rowIndex="0"
                  alignment="TOP_CENTER"
                  spacing="15"
                  prefWidth="620"
                  prefHeight="320"
                  style="-fx-background-color:white;
                         -fx-background-radius:18;
                         -fx-effect:dropshadow(gaussian,#cfcfcf,12,0.3,2,2);">

                <padding>
                    <Insets top="20"
                            bottom="20"/>
                </padding>

                <children>

                    <Label text="Customer Types"
                           style="-fx-font-size:26;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#1f5fe0;"/>

                    <PieChart fx:id="customerChart"
                              legendVisible="true"
                              labelsVisible="true"
                              prefHeight="250"/>

                </children>

            </VBox>

            <!-- ================= Property Types ================= -->

            <VBox GridPane.columnIndex="1"
                  GridPane.rowIndex="0"
                  alignment="TOP_CENTER"
                  spacing="15"
                  prefWidth="620"
                  prefHeight="320"
                  style="-fx-background-color:white;
                         -fx-background-radius:18;
                         -fx-effect:dropshadow(gaussian,#cfcfcf,12,0.3,2,2);">

                <padding>
                    <Insets top="20"
                            bottom="20"/>
                </padding>

                <children>

                    <Label text="Property Types"
                           style="-fx-font-size:26;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#1f5fe0;"/>

                    <PieChart fx:id="propertyChart"
                              legendVisible="true"
                              labelsVisible="true"
                              prefHeight="250"/>

                </children>

            </VBox>

            <!-- ================= Property Structure ================= -->

            <VBox GridPane.columnIndex="0"
                  GridPane.rowIndex="1"
                  alignment="TOP_CENTER"
                  spacing="15"
                  prefWidth="620"
                  prefHeight="320"
                  style="-fx-background-color:white;
                         -fx-background-radius:18;
                         -fx-effect:dropshadow(gaussian,#cfcfcf,12,0.3,2,2);">

                <padding>
                    <Insets top="20"
                            bottom="20"/>
                </padding>

                <children>

                    <Label text="Property Structure"
                           style="-fx-font-size:26;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#1f5fe0;"/>

                    <PieChart fx:id="structureChart"
                              legendVisible="true"
                              labelsVisible="true"
                              prefHeight="250"/>

                </children>

            </VBox>

            <!-- ================= Deal Status ================= -->

            <VBox GridPane.columnIndex="1"
                  GridPane.rowIndex="1"
                  alignment="TOP_CENTER"
                  spacing="15"
                  prefWidth="620"
                  prefHeight="320"
                  style="-fx-background-color:white;
                         -fx-background-radius:18;
                         -fx-effect:dropshadow(gaussian,#cfcfcf,12,0.3,2,2);">

                <padding>
                    <Insets top="20"
                            bottom="20"/>
                </padding>

                <children>

                    <Label text="Deal Status"
                           style="-fx-font-size:26;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#1f5fe0;"/>

                    <PieChart fx:id="dealChart"
                              legendVisible="true"
                              labelsVisible="true"
                              prefHeight="250"/>

                </children>

            </VBox>

        </GridPane>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox alignment="CENTER"
              spacing="20"
              prefHeight="80"
              style="-fx-background-color:#eef3fb;">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <children>

                <Button fx:id="btnDashboard"
                        text="🏠 Go to Dashboard"
                        prefWidth="220"
                        prefHeight="45"
                        onAction="#goDashboard"
                        style="-fx-background-color:#1f5fe0;
                               -fx-text-fill:white;
                               -fx-font-size:18;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;
                               -fx-cursor:hand;"/>

            </children>

        </HBox>

    </bottom>

</BorderPane>