<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1280"
            prefHeight="760"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="BrowseCustomers.BrowseCustomersController"
            stylesheets="@style.css"
            styleClass="root">

    <!-- ================= HEADER ================= -->

    <top>

        <StackPane prefHeight="75"
                   styleClass="header">

            <Label text="👥 Browse Customers"
                   styleClass="header-title"/>

        </StackPane>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <!-- Filter Card -->

            <VBox spacing="20"
                  styleClass="search-card">

                <Label text="Customer Filter"
                       styleClass="section-title"/>

                <HBox spacing="25"
                      alignment="CENTER_LEFT">

                    <Label text="Customer Category"/>

                    <ComboBox fx:id="comboCategory"
                              prefWidth="240"/>

                    <Button text="🔍 Show Data"
                            prefWidth="180"
                            prefHeight="40"
                            styleClass="find-button"
                            onAction="#doShowData"/>

                </HBox>

            </VBox>

            <!-- Table -->

            <TableView fx:id="tableCustomers"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colMobile"
                                 text="Mobile"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colName"
                                 text="Name"
                                 prefWidth="170"/>

                    <TableColumn fx:id="colAddress"
                                 text="Address"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colCity"
                                 text="City"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colEmail"
                                 text="Email"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colCategory"
                                 text="Category"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colDate"
                                 text="Date"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colPicture"
                                 text="Profile Picture"
                                 prefWidth="150"/>

                </columns>

            </TableView>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox alignment="CENTER"
              spacing="20"
              prefHeight="80">

            <padding>
                <Insets top="15"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Button text="📊 Export Excel"
                    prefWidth="180"
                    prefHeight="42"
                    styleClass="excel-button"
                    onAction="#doExcel"/>

            <Button text="📄 Generate PDF"
                    prefWidth="180"
                    prefHeight="42"
                    styleClass="pdf-button"
                    onAction="#doPDF"/>

            <Button text="🏠 Dashboard"
                    prefWidth="180"
                    prefHeight="42"
                    styleClass="dashboard-button"
                    onAction="#goDashboard"/>

        </HBox>

    </bottom>

</BorderPane>